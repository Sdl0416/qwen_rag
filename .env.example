# 阿里云 Model Studio API Key
DASHSCOPE_API_KEY=sk-your-key

# 当前 Model Studio OpenAI 兼容接口使用 workspace-specific base URL。
# 下面仅为格式示例，请从你自己的 Model Studio Workspace 复制。
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 可以按你的账号实际可用模型修改
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBED_MODEL=qwen3.7-text-embedding
QWEN_EMBED_DIM=1024
